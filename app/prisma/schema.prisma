  FAIL
}

enum ReviewGateStage {
  AI_SELF_VALIDATION
  PEER_REVIEW
  HUMAN_REVIEW
  GOVERNANCE_APPROVAL
}

enum ReviewGateStatusEnum {
  PENDING
  PASSED
  REJECTED
  REVISION_REQUESTED
}

enum RagStatus {
  GREEN
  AMBER
  RED
}

enum HypercareTaskStatus {
  BACKLOG
  IN_PROGRESS
  BLOCKED
  DONE
  ESCALATED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

enum GoLiveStatus {
  PENDING
  COMPLETED
  BLOCKED
  NOT_APPLICABLE
}

enum ChangeRequestStatus {
  PROPOSED
  IN_REVIEW
  APPROVED
  REJECTED
  IMPLEMENTED
}

enum PostImplRiskStatus {
  OPEN
  MONITORING
  MITIGATED
  CLOSED
