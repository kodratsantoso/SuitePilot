// SuitePilot — Prisma Schema
// Last updated: 2026-05-16 (Prompt 13 — SaaS Multi-Tenant Management Layer)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

enum CustomerStatus {
  LEAD
  QUALIFIED
  PROSPECT
  CUSTOMER
  INACTIVE
}

enum ProjectType {
  NEW_IMPLEMENTATION
  OPTIMIZATION
  INTEGRATION
  SUPPORT
  UPGRADE
  ASSESSMENT
}

enum ProjectStatus {
  DRAFT
  PLANNED
  ACTIVE
  ON_HOLD
  AT_RISK
  DELAYED
  COMPLETED
  CANCELLED
}

enum ProjectHealth {
  GREEN
  AMBER
  RED
  UNKNOWN
}

enum ProjectPhase {
  PRESALES
  DISCOVERY
  DESIGN
  BUILD
  UAT
  CUTOVER
  HYPERCARE
  CLOSED
}

enum ProjectMemberRole {
  PROJECT_MANAGER
  FUNCTIONAL_CONSULTANT
  TECHNICAL_CONSULTANT
  SOLUTION_ARCHITECT
  QA
  DEVELOPER
  STAKEHOLDER
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
  AT_RISK
  CANCELLED
}

enum RaidType {
  RISK
  ASSUMPTION
  ISSUE
  DEPENDENCY
  DECISION
}

enum RaidStatus {
  OPEN
  MONITORING
  MITIGATED
  RESOLVED
  CLOSED
  ESCALATED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DiscoverySessionStatus {
  DRAFT
  ACTIVE
  IN_REVIEW
  COMPLETED
  ARCHIVED
}

enum QuestionCategory {
  COMPANY_PROFILE
  FINANCE
  PROCUREMENT
  INVENTORY
  SALES
  CRM
  MANUFACTURING
  REPORTING
  INTEGRATION
  COMPLIANCE
  PAIN_POINT
  GOVERNANCE
  TECHNICAL
  OTHER
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequirementSource {
  MANUAL
  AI_EXTRACTED
  MEETING
  DOCUMENT
  INTERVIEW
}

enum AssumptionStatus {
  OPEN
  VALIDATED
  INVALID
  PENDING_REVIEW
}

enum AiConversationStatus {
  ACTIVE
  ARCHIVED
  LOCKED
}

enum AiMessageRole {
  SYSTEM
  USER
  ASSISTANT
}

enum AiOutputType {
  DISCOVERY_SUMMARY
  REQUIREMENT_ANALYSIS
  PAIN_POINT_ANALYSIS
  MODULE_RECOMMENDATION
  SCOPE_DRAFT
  PROPOSAL_DRAFT
  BRD_DRAFT
  FIT_GAP_DRAFT
  RISK_SUMMARY
  MEETING_SUMMARY
}

enum AiOutputStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  REVISED
  PUBLISHED
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum KnowledgeSourceStatus {
  ACTIVE
  DEPRECATED
  ARCHIVED
}

enum EvaluationRunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  NEEDS_REVIEW
}

enum AiReviewStatus {
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum GovernanceEventType {
  HALLUCINATION_DETECTED
  VALIDATION_PASSED
  VALIDATION_FAILED
  REVIEW_SUBMITTED
  QUALITY_SCORE_ASSIGNED
}

enum ValidationType {
  SCHEMA_CHECK
  DATA_CONSISTENCY
  BUSINESS_RULE_CHECK
}

enum ValidationResult {
  PASS
