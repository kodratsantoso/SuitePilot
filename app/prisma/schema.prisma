}

// ─────────────────────────────────────────────────────────────────────────────
// AI Governance & RAG Layer
// ─────────────────────────────────────────────────────────────────────────────

model GovernanceEvent {
  id                  String               @id @default(uuid())
  organizationId      String
  projectId           String
  aiGeneratedOutputId String
  agentName           String?
  skillName           String?
  eventType           GovernanceEventType
  severity            Severity             @default(MEDIUM)
  qualityScore        Float?
  confidenceScore     Float?
  ragStatus           RagStatus            @default(AMBER)
  reviewerId          String?
  notes               String?
  createdAt           DateTime             @default(now())

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  output   AiGeneratedOutput @relation(fields: [aiGeneratedOutputId], references: [id], onDelete: Cascade)
  reviewer User?             @relation("GovernanceReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@index([aiGeneratedOutputId])
  @@index([eventType])
  @@index([ragStatus])
  @@index([createdAt])
}

model OutputValidation {
  id                  String           @id @default(uuid())
  organizationId      String
  projectId           String
  aiGeneratedOutputId String
  validationType      ValidationType
  result              ValidationResult @default(PASS)
  notes               String?
  createdAt           DateTime         @default(now())

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  output  AiGeneratedOutput @relation(fields: [aiGeneratedOutputId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId])
  @@index([aiGeneratedOutputId])
  @@index([validationType])
  @@index([result])
}

model ReviewGateStatus {
  id                  String               @id @default(uuid())
  organizationId      String
  projectId           String
  aiGeneratedOutputId String
  stage               ReviewGateStage
  status              ReviewGateStatusEnum @default(PENDING)
  reviewerId          String?
  notes               String?
  createdAt           DateTime             @default(now())

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  output   AiGeneratedOutput @relation(fields: [aiGeneratedOutputId], references: [id], onDelete: Cascade)
  reviewer User?             @relation("ReviewGateReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@index([aiGeneratedOutputId])
  @@index([stage])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Enterprise Reporting & Dashboard Layer
// ─────────────────────────────────────────────────────────────────────────────

model DashboardKpiSnapshot {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String?
  workstreamId   String?
  metricName     String
  metricValue    Float
  metricUnit     String?
  metadata       Json?
  snapshotAt     DateTime @default(now())

  @@index([organizationId])
  @@index([projectId])
  @@index([metricName])
  @@index([snapshotAt])
}

model DashboardTrendHistory {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String?
  metricName     String
  metricValue    Float
  period         String
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([projectId])
  @@index([metricName])
  @@index([period])
}

model DashboardRagSummary {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  greenCount     Int      @default(0)
  amberCount     Int      @default(0)
  redCount       Int      @default(0)
  totalOutputs   Int      @default(0)
  snapshotAt     DateTime @default(now())

  @@index([organizationId])
  @@index([projectId])
  @@index([snapshotAt])
}

model DashboardHypercareSummary {
  id                    String   @id @default(uuid())
  organizationId        String
  projectId             String
  openIssues            Int      @default(0)
  resolvedIssues        Int      @default(0)
  criticalIssues        Int      @default(0)
  goLiveCompletion      Float    @default(0)
  openTasks             Int      @default(0)
  completedTasks        Int      @default(0)
  pendingChangeRequests Int      @default(0)
  snapshotAt            DateTime @default(now())

  @@index([organizationId])
  @@index([projectId])
  @@index([snapshotAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Prompt 12 — AI Continuous Improvement Layer
// ─────────────────────────────────────────────────────────────────────────────

enum FeedbackType {
  HUMAN_REVIEW
  GOVERNANCE_FLAG
  HYPERCARE_OUTCOME
  TASK_OUTCOME
  RISK_OBSERVED
  AI_OUTPUT_PERFORMANCE
}

enum FeedbackSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecommendationType {
  PROCESS
  AI_MODEL
  WORKFLOW
  RISK_MITIGATION
}

enum RecommendationStatus {
  DRAFT
  REVIEWED
  APPROVED
  IMPLEMENTED
  REJECTED
}

enum OptimizationMetricType {
  EFFICIENCY
  ACCURACY
  RISK_MITIGATION
  AI_OUTPUT_QUALITY
}

model FeedbackEntry {
  id                  String           @id @default(uuid())
  organizationId      String
  projectId           String
  workstreamId        String?
  aiGeneratedOutputId String?
  feedbackType        FeedbackType
  description         String           @db.Text
  severity            FeedbackSeverity @default(MEDIUM)
  confidenceScore     Float?
  createdBy           String
  createdAt           DateTime         @default(now())

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser     User               @relation("FeedbackCreatedBy", fields: [createdBy], references: [id])
  aiGeneratedOutput AiGeneratedOutput? @relation(fields: [aiGeneratedOutputId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@index([feedbackType])
  @@index([severity])
  @@index([createdAt])
}

model OptimizationRecommendation {
  id                 String               @id @default(uuid())
  organizationId     String
  projectId          String
  workstreamId       String?
  recommendationType RecommendationType
  description        String               @db.Text
  confidenceScore    Float?
  impactScore        Float?
  status             RecommendationStatus @default(DRAFT)
  createdBy          String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser User    @relation("RecommendationCreatedBy", fields: [createdBy], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@index([recommendationType])
  @@index([status])
}

model OptimizationScore {
  id             String                 @id @default(uuid())
  organizationId String
  projectId      String
  workstreamId   String?
  metricType     OptimizationMetricType
  score          Float
  ragStatus      RagStatus
  calculatedAt   DateTime               @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId])
  @@index([metricType])
  @@index([calculatedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Prompt 13 — SaaS Multi-Tenant Management Layer
// ─────────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  TRIAL
}

enum UsageMetricType {
  AI_OUTPUT_COUNT
  API_USAGE
  STORAGE_USED
  ACTIVE_USERS
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  VOID
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String
  features      Json
  pricePerMonth Float    @default(0)
  pricePerYear  Float    @default(0)
  maxUsers      Int      @default(5)
  maxProjects   Int      @default(10)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenants  Tenant[]
  invoices BillingInvoice[]

  @@index([isActive])
}

model Tenant {
  id                 String          @id @default(uuid())
  organizationId     String          @unique
  name               String
  domain             String?
  status             TenantStatus    @default(ACTIVE)
  subscriptionPlanId String?
  trialEndsAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionPlan SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)
  usageRecords     TenantUsage[]
  invoices         BillingInvoice[]
  roles            TenantRole[]
  userRoles        TenantUserRole[]
  deploymentServices DeploymentService[]
  deploymentRuns     DeploymentRun[]
  serviceMetrics     ServiceMetric[]
  deploymentAlerts   DeploymentAlert[]
  secretStores        SecretStore[]
  accessLogs          AccessLog[]
  superuserActionLogs SuperuserActionLog[]
  globalAnalyticsSnapshots GlobalAnalyticsSnapshot[]

  @@index([status])
  @@index([subscriptionPlanId])
}

model TenantUsage {
  id           String          @id @default(uuid())
  tenantId     String
  metricType   UsageMetricType
  value        Float
  periodStart  DateTime
  periodEnd    DateTime
  createdAt    DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([metricType])
  @@index([periodStart])
}

model BillingInvoice {
  id                  String        @id @default(uuid())
  tenantId            String
  subscriptionPlanId  String?
  billingPeriodStart  DateTime
  billingPeriodEnd    DateTime
  amount              Float
  status              InvoiceStatus @default(PENDING)
  paymentMethod       String?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionPlan SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([billingPeriodStart])
}

// ─────────────────────────────────────────────────────────────────────────────
// Security & Compliance Models (Prompt 15)
// ─────────────────────────────────────────────────────────────────────────────

enum EncryptionMethod {
  AES_256_GCM
  RSA
  HASHED
}

enum SecretType {
  API_KEY
  DB_PASSWORD
  TOKEN
  WEBHOOK_SECRET
  OAUTH_CLIENT_SECRET
}

enum RotationPolicy {
  MANUAL
  DAYS_30
  DAYS_60
  DAYS_90
}

enum AccessActionType {
  READ
  CREATE
  UPDATE
  DELETE
  EXPORT
  ROTATE_SECRET
  REVOKE_SECRET
  LOGIN
  LOGOUT
  SECURITY_CHECK
}

enum AccessResult {
  SUCCESS
  FAILURE
}

enum SecretStatus {
  ACTIVE
  ROTATED
  REVOKED
}

model EncryptedField {
  id               String           @id @default(uuid())
  tableName        String
  columnName       String
  encryptionMethod EncryptionMethod
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([tableName, columnName])
  @@index([tableName])
}

model AccessLog {
  id           String         @id @default(uuid())
  organizationId String?
  userId       String?
  tenantId     String?
  projectId    String?
  entityType   String
  entityId     String?
  actionType   AccessActionType
  result       AccessResult
  ipAddress    String?
  userAgent    String?
  metadata     Json           @default("{}")
  timestamp    DateTime       @default(now())

  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant       Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([tenantId])
  @@index([projectId])
  @@index([entityType])
  @@index([actionType])
  @@index([result])
  @@index([timestamp])
}

model SecretStore {
  id               String         @id @default(uuid())
  organizationId   String
  tenantId         String?
  secretType       SecretType
  secretName       String
  secretValue      String
  encryptionMethod EncryptionMethod @default(AES_256_GCM)
  status           SecretStatus     @default(ACTIVE)
  rotationPolicy   RotationPolicy   @default(DAYS_90)
  lastRotatedAt    DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([organizationId, tenantId, secretName])
  @@index([organizationId])
  @@index([tenantId])
  @@index([secretType])
  @@index([status])
}


model TenantRole {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles TenantUserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model TenantUserRole {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   TenantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, roleId])
  @@index([tenantId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Prompt 14 — Deployment & DevOps Layer
// ─────────────────────────────────────────────────────────────────────────────

enum DeploymentEnvironmentType {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum DeploymentEnvironmentStatus {
  ACTIVE
  DEGRADED
  MAINTENANCE
  OFFLINE
}

enum DeploymentServiceStatus {
  PENDING
  BUILDING
  DEPLOYING
  RUNNING
  DEGRADED
  FAILED
  ROLLING_BACK
  STOPPED
}

enum DeploymentHealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
}

enum DeploymentActionType {
  BUILD
  TEST
  DEPLOY
  ROLLBACK
  SCALE
  SELF_HEAL
}

enum DeploymentRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
  ROLLED_BACK
}

enum ServiceMetricType {
  CPU_USAGE
  MEMORY_USAGE
  LATENCY_MS
  ERROR_RATE
  UPTIME_SECONDS
}

enum DeploymentAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum DeploymentAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum SuperuserActionType {
  TenantActivation
  SubscriptionOverride
  UserRoleChange
  DeploymentTrigger
}

enum GlobalMetricType {
  CrossTenantKPI
  AIOutputQuality
  RAGDistribution
  UsageSummary
}

model DeploymentEnvironment {
  id          String                      @id @default(uuid())
  name        String
  slug        String                      @unique
  type        DeploymentEnvironmentType
  status      DeploymentEnvironmentStatus @default(ACTIVE)
  region      String?
  baseUrl     String?
  registryUrl String?
  secretsRef  String?
  config      Json                        @default("{}")
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  services DeploymentService[]
  runs     DeploymentRun[]
  metrics  ServiceMetric[]
  alerts   DeploymentAlert[]

  @@index([type])
  @@index([status])
}

model DeploymentService {
  id              String                 @id @default(uuid())
  environmentId   String
  tenantId        String?
  name            String
  module          String
  image           String?
  imageTag        String?
  desiredReplicas Int                    @default(1)
  currentReplicas Int                    @default(0)
  status          DeploymentServiceStatus @default(PENDING)
  healthStatus    DeploymentHealthStatus @default(UNKNOWN)
  lastDeployedAt  DateTime?
  lastCheckedAt   DateTime?
  config          Json                   @default("{}")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  environment DeploymentEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  tenant      Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  runs        DeploymentRun[]
  metrics     ServiceMetric[]
  alerts      DeploymentAlert[]

  @@unique([environmentId, tenantId, name])
  @@index([environmentId])
  @@index([tenantId])
  @@index([status])
  @@index([healthStatus])
}

model DeploymentRun {
  id                  String              @id @default(uuid())
  organizationId      String
  tenantId            String?
  environmentId       String
  serviceId           String?
  actionType          DeploymentActionType
  status              DeploymentRunStatus @default(QUEUED)
  version             String?
  imageTag            String?
  commitSha           String?
  rollbackTargetRunId String?
  triggeredBy         String?
  startedAt           DateTime            @default(now())
  finishedAt          DateTime?
  logs                Json                @default("[]")
  metadata            Json                @default("{}")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant       Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  environment  DeploymentEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  service      DeploymentService?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  actor        User?                 @relation("DeploymentTriggeredBy", fields: [triggeredBy], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([tenantId])
  @@index([environmentId])
  @@index([serviceId])
  @@index([actionType])
  @@index([status])
  @@index([startedAt])
}

model ServiceMetric {
  id            String            @id @default(uuid())
  environmentId String
  serviceId     String?
  tenantId      String?
  metricType    ServiceMetricType
  value         Float
  unit          String?
  measuredAt    DateTime          @default(now())

  environment DeploymentEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  service     DeploymentService?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  tenant      Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([environmentId])
  @@index([serviceId])
  @@index([tenantId])
  @@index([metricType])
  @@index([measuredAt])
}

model DeploymentAlert {
  id            String                  @id @default(uuid())
  environmentId String
  serviceId     String?
  tenantId      String?
  severity      DeploymentAlertSeverity
  status        DeploymentAlertStatus   @default(OPEN)
  message       String
  source        String?
  createdAt     DateTime                @default(now())
  resolvedAt    DateTime?

  environment DeploymentEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  service     DeploymentService?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  tenant      Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([environmentId])
  @@index([serviceId])
  @@index([tenantId])
  @@index([severity])
  @@index([status])
}

model SuperuserActionLog {
  id              String              @id @default(uuid())
  superuserId     String
  actionType      SuperuserActionType
  targetTenantId  String?
  targetProjectId String?
  description     String              @db.Text
  timestamp       DateTime            @default(now())

  superuser     User     @relation("SuperuserActionActor", fields: [superuserId], references: [id], onDelete: Restrict)
  targetTenant  Tenant?  @relation(fields: [targetTenantId], references: [id], onDelete: SetNull)
  targetProject Project? @relation(fields: [targetProjectId], references: [id], onDelete: SetNull)

  @@index([superuserId])
  @@index([actionType])
  @@index([targetTenantId])
  @@index([targetProjectId])
  @@index([timestamp])
}

model GlobalAnalyticsSnapshot {
  id           String           @id @default(uuid())
  metricType   GlobalMetricType
  value        Json
  tenantId     String?
  projectId    String?
  snapshotDate DateTime         @default(now())

  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([metricType])
  @@index([tenantId])
  @@index([projectId])
  @@index([snapshotDate])
}

model KnowledgeSource {
  id             String                @id @default(uuid())
  organizationId String
  projectId      String?
  name           String
  category       String
  ownerId        String
  status         KnowledgeSourceStatus @default(ACTIVE)
  lastUpdatedAt  DateTime              @default(now())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User     @relation("KnowledgeSourceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  documents KnowledgeDocument[]

  @@index([organizationId])
  @@index([projectId])
  @@index([category])
  @@index([status])
}

model KnowledgeDocument {
  id          String   @id @default(uuid())
  sourceId    String
  title       String
  content     String   @db.Text
  tags        Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([sourceId])
}

model KnowledgeChunk {
  id          String   @id @default(uuid())
  documentId  String
  content     String   @db.Text
  chunkIndex  Int
  citationRef String?
  embedding   Json?
  createdAt   DateTime @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  retrievalLogs RetrievalLog[]

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model RetrievalLog {
  id          String   @id @default(uuid())
  chunkId     String
  query       String
  score       Float?
  usedInOutputId String?
  createdAt   DateTime @default(now())

  chunk KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([chunkId])
  @@index([usedInOutputId])
}

model EvaluationCase {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String?
  skillName      String
  prompt         String   @db.Text
  expectedAnswer String   @db.Text
  riskLevel      Severity @default(MEDIUM)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs    AiEvaluationRun[]

  @@index([organizationId])
  @@index([projectId])
  @@index([skillName])
}

model AiEvaluationRun {
  id                  String              @id @default(uuid())
  organizationId      String
  projectId           String?
  evaluationCaseId    String
  aiGeneratedOutputId String?
  runBy               String
  status              EvaluationRunStatus @default(QUEUED)
  score               Float?
  findings            Json                @default("[]")
  createdAt           DateTime            @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evaluationCase EvaluationCase @relation(fields: [evaluationCaseId], references: [id], onDelete: Cascade)
  output AiGeneratedOutput? @relation(fields: [aiGeneratedOutputId], references: [id], onDelete: SetNull)
  runner User @relation("EvaluationRunner", fields: [runBy], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([projectId])
  @@index([evaluationCaseId])
  @@index([aiGeneratedOutputId])
  @@index([status])
}
