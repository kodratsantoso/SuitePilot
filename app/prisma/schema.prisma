  DATA_MIGRATION_PLAN
  SECURITY_PLAN
}

enum TechnicalStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

enum WorkstreamStatus {
  PLANNED
  ACTIVE
  BLOCKED
  COMPLETED
  ON_HOLD
}

enum ProcessCategory {
  PROCURE_TO_PAY
  ORDER_TO_CASH
  RECORD_TO_REPORT
  INVENTORY_MANAGEMENT
  FIXED_ASSET
  CRM
  MANUFACTURING
  APPROVAL_WORKFLOW
  REPORTING
  PROJECT_ACCOUNTING
}

enum FitCategory {
  FIT_STANDARD
  FIT_WITH_CONFIGURATION
  FIT_WITH_WORKFLOW
  FIT_WITH_CUSTOMIZATION
  FIT_WITH_INTEGRATION
  GAP
  OUT_OF_SCOPE
}

enum UatScenarioStatus {
  DRAFT
  READY
  IN_TESTING
  PASSED
  FAILED
  RETEST_REQUIRED
}

enum UatCategory {
  POSITIVE_TEST
  NEGATIVE_TEST
  APPROVAL_TEST
  INTEGRATION_TEST
  REGRESSION_TEST
  SECURITY_TEST
}

enum SopStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum DeliverableType {
  PROCESS_MAPPING
  FIT_GAP_ANALYSIS
  UAT
  SOP
  CONFIGURATION_WORKBOOK
  TRAINING_MATERIAL
  MIGRATION_TEMPLATE
}

enum FunctionalDeliverableStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  REVISION_REQUESTED
  PUBLISHED
}

enum EstimatedComplexity {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum ProposalSectionType {
  EXECUTIVE_SUMMARY
  CHALLENGES
  PROPOSED_SOLUTION
  SCOPE
  TIMELINE
  ASSUMPTIONS
  RISKS
  DELIVERABLES
  NEXT_STEPS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  VIEW
  EXPORT
  APPROVE
  REJECT
}

// ─────────────────────────────────────────────────────────────────────────────
// Organization
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  users     User[]
  customers Customer[]
  projects  Project[]
  auditLogs AuditLog[]
  roles     Role[]
  tenant    Tenant?
  deploymentRuns DeploymentRun[]
  secretStores SecretStore[]
  accessLogs   AccessLog[]
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id             String     @id @default(uuid())
  organizationId String
  name           String
  email          String
  passwordHash   String?
  avatarUrl      String?
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Project role relations (named to avoid ambiguity)
  managedProjects    Project[] @relation("ProjectManager")
  functionalProjects Project[] @relation("FunctionalLead")
  technicalProjects  Project[] @relation("TechnicalLead")
  createdProjects    Project[] @relation("ProjectCreator")
  updatedProjects    Project[] @relation("ProjectUpdater")

  projectMemberships ProjectMember[]
  ownedTasks         ProjectTask[]      @relation("TaskOwner")
  createdTasks       ProjectTask[]      @relation("TaskCreator")
  updatedTasks       ProjectTask[]      @relation("TaskUpdater")
  ownedMilestones    ProjectMilestone[] @relation("MilestoneOwner")
  createdMilestones  ProjectMilestone[] @relation("MilestoneCreator")
  ownedRaidItems     RaidItem[]         @relation("RaidOwner")
  createdRaidItems   RaidItem[]         @relation("RaidCreator")
  updatedRaidItems   RaidItem[]         @relation("RaidUpdater")
  auditLogs          AuditLog[]
  createdCustomers   Customer[]         @relation("CustomerCreator")
  updatedCustomers   Customer[]         @relation("CustomerUpdater")
  userRoles          UserRole[]

  // Functional delivery relations
  ownedWorkstreams          FunctionalWorkstream[] @relation("WorkstreamOwner")
  ownedTechnicalWorkstreams TechnicalWorkstream[]  @relation("TechnicalWorkstreamOwner")
  ownedHypercareTasks         HypercareTask[]   @relation("HypercareTaskOwner")
  assignedIssues              Issue[]           @relation("IssueAssignee")
  requestedChanges            ChangeRequest[]   @relation("ChangeRequester")
  governanceReviews           GovernanceEvent[] @relation("GovernanceReviewer")
  reviewGateReviews           ReviewGateStatus[] @relation("ReviewGateReviewer")

  // AI Discovery relations
  createdSessions      DiscoverySession[]  @relation("SessionCreator")
  updatedSessions      DiscoverySession[]  @relation("SessionUpdater")
  discoveryAnswers     DiscoveryAnswer[]   @relation("AnswerAuthor")
  createdRequirements  Requirement[]       @relation("RequirementCreator")
  createdConversations AiConversation[]    @relation("ConversationCreator")
  createdOutputs       AiGeneratedOutput[]          @relation("OutputCreator")
  outputReviews        AiReview[]                   @relation("OutputReviewer")
  feedbackEntries      FeedbackEntry[]              @relation("FeedbackCreatedBy")
  recommendations      OptimizationRecommendation[] @relation("RecommendationCreatedBy")
  tenantUserRoles      TenantUserRole[]
  triggeredDeployments DeploymentRun[]              @relation("DeploymentTriggeredBy")
  accessLogs           AccessLog[]
  superuserActionLogs  SuperuserActionLog[]         @relation("SuperuserActionActor")
  projectDocuments     ProjectDocument[]            @relation("DocumentCreator")
  documentReviews      ReviewComment[]              @relation("ReviewCommentAuthor")
  knowledgeSources     KnowledgeSource[]            @relation("KnowledgeSourceOwner")
  evaluationRuns       AiEvaluationRun[]            @relation("EvaluationRunner")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Role & Permission (RBAC)
// ─────────────────────────────────────────────────────────────────────────────

model Role {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Customer
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  industry       String?
  companySize    String?
  country        String?
  website        String?
  status         CustomerStatus @default(LEAD)
  notes          String?
  createdBy      String
  updatedBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator      User         @relation("CustomerCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater      User?        @relation("CustomerUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  projects     Project[]

  @@index([organizationId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Project
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id                 String        @id @default(uuid())
  organizationId     String
  customerId         String
  projectCode        String
  name               String
  description        String?
  projectType        ProjectType   @default(NEW_IMPLEMENTATION)
  status             ProjectStatus @default(DRAFT)
  health             ProjectHealth @default(UNKNOWN)
  currentPhase       ProjectPhase  @default(PRESALES)
  startDate          DateTime?
  targetGoLiveDate   DateTime?
  actualGoLiveDate   DateTime?
  progressPercentage Int           @default(0)
  projectManagerId   String?
  functionalLeadId   String?
  technicalLeadId    String?
  createdBy          String
  updatedBy          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  projectManager User?        @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  functionalLead User?        @relation("FunctionalLead", fields: [functionalLeadId], references: [id], onDelete: SetNull)
  technicalLead  User?        @relation("TechnicalLead", fields: [technicalLeadId], references: [id], onDelete: SetNull)
  creator        User         @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater        User?        @relation("ProjectUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  members    ProjectMember[]
  tasks      ProjectTask[]
  milestones ProjectMilestone[]
  raidItems  RaidItem[]
  auditLogs  AuditLog[]
  accessLogs AccessLog[]
  superuserActionLogs SuperuserActionLog[]
  globalAnalyticsSnapshots GlobalAnalyticsSnapshot[]
  projectDocuments ProjectDocument[]
  knowledgeSources KnowledgeSource[]
  evaluationCases EvaluationCase[]
  evaluationRuns AiEvaluationRun[]

  // AI Discovery relations
  discoverySessions          DiscoverySession[]
  requirements               Requirement[]
  painPoints                 PainPoint[]
  assumptions                Assumption[]
  discoveryRisks             DiscoveryRisk[]
  recommendedModules         RecommendedModule[]
  conversations              AiConversation[]
  generatedOutputs           AiGeneratedOutput[]
  // AI Presales relations
  requirementAnalyses          RequirementAnalysis[]
  painPointClassifications     PainPointClassification[]
  moduleRecommendationAnalyses ModuleRecommendationAnalysis[]
  scopeEstimations             ScopeEstimation[]
  proposalDraftSections        ProposalDraftSection[]
  // Functional Delivery relations
  workstreams            FunctionalWorkstream[]
  businessProcesses      BusinessProcess[]
  fitGapAnalyses         FitGapAnalysis[]
  uatScenarios           UatScenario[]
  sopDocuments           SopDocument[]
  functionalDeliverables FunctionalDeliverable[]
  // Technical Delivery relations
  technicalWorkstreams  TechnicalWorkstream[]
  integrationMappings   IntegrationMapping[]
  restletDesigns        RestletDesign[]
  apiContracts          ApiContract[]
  payloadValidations    PayloadValidation[]
  technicalDeliverables TechnicalDeliverable[]
  // Hypercare & Post-Implementation relations
  hypercareTasks           HypercareTask[]
  issues                   Issue[]
  goLiveReadinessItems     GoLiveReadiness[]
  changeRequests           ChangeRequest[]
  postImplementationRisks  PostImplementationRisk[]
  // Governance relations
  governanceEvents  GovernanceEvent[]
  outputValidations OutputValidation[]
  reviewGates       ReviewGateStatus[]
  // Continuous improvement relations
  feedbackEntries              FeedbackEntry[]
  optimizationRecommendations  OptimizationRecommendation[]
  optimizationScores           OptimizationScore[]

  @@unique([organizationId, projectCode])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@index([health])
}

// ─────────────────────────────────────────────────────────────────────────────
// ProjectMember
// ─────────────────────────────────────────────────────────────────────────────

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(STAKEHOLDER)
  createdAt DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ProjectTask
// ─────────────────────────────────────────────────────────────────────────────

model ProjectTask {
  id            String       @id @default(uuid())
  projectId     String
  title         String
  description   String?
  status        TaskStatus   @default(BACKLOG)
  priority      TaskPriority @default(MEDIUM)
  ownerId       String?
  startDate     DateTime?
  dueDate       DateTime?
  completedDate DateTime?
  createdBy     String
  updatedBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  creator User    @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User?   @relation("TaskUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@index([ownerId])
  @@index([dueDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// ProjectMilestone
// ─────────────────────────────────────────────────────────────────────────────

model ProjectMilestone {
  id                   String          @id @default(uuid())
  projectId            String
  name                 String
  description          String?
  status               MilestoneStatus @default(NOT_STARTED)
  targetDate           DateTime
  actualDate           DateTime?
  completionPercentage Int             @default(0)
  ownerId              String?
  createdBy            String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  creator User    @relation("MilestoneCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([status])
  @@index([targetDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// RaidItem
// ─────────────────────────────────────────────────────────────────────────────

model RaidItem {
  id          String     @id @default(uuid())
  projectId   String
  type        RaidType
  title       String
  description String
  status      RaidStatus @default(OPEN)
  severity    Severity?
  probability Severity?
  impact      Severity?
  mitigation  String?
  ownerId     String?
  dueDate     DateTime?
  createdBy   String
  updatedBy   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation("RaidOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  creator User    @relation("RaidCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User?   @relation("RaidUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([type])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// AuditLog — immutable, append-only
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String      @id @default(uuid())
  organizationId String
  projectId      String?
  actorUserId    String?
  entityType     String
  entityId       String?
  action         AuditAction
  beforeData     Json?
  afterData      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI Discovery Workspace
// ─────────────────────────────────────────────────────────────────────────────

model DiscoverySession {
  id             String                 @id @default(uuid())
  organizationId String
  projectId      String
  title          String
  description    String?
  status         DiscoverySessionStatus @default(DRAFT)
  startedAt      DateTime?
  completedAt    DateTime?
  createdBy      String
  updatedBy      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator  User    @relation("SessionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User?   @relation("SessionUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  questions          DiscoveryQuestion[]
  answers            DiscoveryAnswer[]
  requirements       Requirement[]
  painPoints         PainPoint[]
  assumptions        Assumption[]
  discoveryRisks     DiscoveryRisk[]
  recommendedModules RecommendedModule[]
  conversations      AiConversation[]
  generatedOutputs   AiGeneratedOutput[]
  // Presales relations
  requirementAnalyses          RequirementAnalysis[]
  moduleRecommendationAnalyses ModuleRecommendationAnalysis[]
  scopeEstimations             ScopeEstimation[]

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
}

model DiscoveryQuestion {
  id                 String           @id @default(uuid())
  discoverySessionId String
  category           QuestionCategory
  question           String
  order              Int              @default(0)
  createdAt          DateTime         @default(now())

  session DiscoverySession  @relation(fields: [discoverySessionId], references: [id], onDelete: Cascade)
  answers DiscoveryAnswer[]

  @@index([discoverySessionId])
  @@index([category])
}

model DiscoveryAnswer {
  id                  String   @id @default(uuid())
  discoveryQuestionId String
  discoverySessionId  String
  answer              String
  answeredBy          String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  question DiscoveryQuestion @relation(fields: [discoveryQuestionId], references: [id], onDelete: Cascade)
  session  DiscoverySession  @relation(fields: [discoverySessionId], references: [id], onDelete: Cascade)
  answerer User              @relation("AnswerAuthor", fields: [answeredBy], references: [id], onDelete: Restrict)

  @@index([discoverySessionId])
  @@index([discoveryQuestionId])
}

model Requirement {
  id                 String              @id @default(uuid())
  organizationId     String
  projectId          String
  discoverySessionId String?
  title              String
  description        String?
  category           QuestionCategory?
  priority           RequirementPriority @default(MEDIUM)
  source             RequirementSource   @default(MANUAL)
  createdBy          String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session      DiscoverySession? @relation(fields: [discoverySessionId], references: [id], onDelete: SetNull)
  creator      User              @relation("RequirementCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  analyses     RequirementAnalysis[]
  fitGapItems  FitGapAnalysis[]

  @@index([organizationId])
  @@index([projectId])
  @@index([discoverySessionId])
  @@index([priority])
}

model PainPoint {
  id                 String    @id @default(uuid())
  organizationId     String
  projectId          String
  discoverySessionId String?
  title              String
  description        String?
  severity           Severity  @default(MEDIUM)
  impactedArea       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

