{
  "name": "suitepilot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./app/backend\" --filter \"./app/frontend\" dev",
    "build": "pnpm --filter \"./app/backend\" build && pnpm --filter \"./app/frontend\" build",
    "typecheck": "pnpm --filter \"./app/backend\" typecheck && pnpm --filter \"./app/frontend\" typecheck",
    "lint": "pnpm --filter \"./app/backend\" lint && pnpm --filter \"./app/frontend\" lint",
    "test": "pnpm --filter \"./app/backend\" test",
    "db:generate": "pnpm --filter \"./app/backend\" db:generate",
    "db:migrate": "pnpm --filter \"./app/backend\" db:migrate",
    "db:migrate:prod": "pnpm --filter \"./app/backend\" db:migrate:prod",
    "db:seed": "pnpm --filter \"./app/backend\" db:seed",
    "db:studio": "pnpm --filter \"./app/backend\" db:studio",
    "db:reset": "pnpm --filter \"./app/backend\" db:reset"
  }
}
