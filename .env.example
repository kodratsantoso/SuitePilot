# ─────────────────────────────────────────────────────────────
# AI NetSuite Implementation OS — Environment Variable Template
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
APP_NAME="AI NetSuite Implementation OS"
APP_URL=http://localhost:5100
API_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5100

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/suitepilot

# Cache / Queue
REDIS_URL=redis://localhost:6380

# AI Provider Keys (fill in your own keys, never commit real values)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Authentication
JWT_SECRET=
SESSION_SECRET=
SECURITY_ENCRYPTION_KEY=
SUPERUSER_EMAILS=admin@example.com

# Optional: Storage (S3-compatible for document uploads)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Optional: Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
